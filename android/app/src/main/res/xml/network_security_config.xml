<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base Config: Izinkan koneksi standar (wajib HTTPS) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Domain API Produksi: Wajib HTTPS dan hanya percaya Certificate Authority resmi Sistem -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">secureapi.pandemenulis.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Debug Override: Izinkan sertifikat pengguna (user CA) hanya saat pengujian / development -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
