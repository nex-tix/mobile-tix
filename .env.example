# API Configuration
BASE_URL=http://localhost:8081/api/login
API_TIMEOUT=30000

# Mock Mode (set false when real backend is ready)
USE_MOCK_API=true

# Encryption & Security
IS_NEED_ENCRYPT=true
SECRET_KEY=your-32-char-secret-key-12345678
IV=1234567890123456

# Request Signature
SIGNATURE_SECRET=your-signature-secret-here-changeme

# App Config
CHANNEL_CD=01
DEFAULT_LANGUAGE=id

# Feature Flags (optional)
ENABLE_OFFLINE_QUEUE=true
ENABLE_AUTO_LOGOUT=true
ENABLE_AUDIO_FEEDBACK=true
